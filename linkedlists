#include <iostream>
using namespace std;

struct node {
    int data = 0;
    node* next = nullptr;
};
// add function that adds from back
void add(int x, node* &current) {
    node* list = new node;
    list->data = x;
    node* copy = current;
    if (current == nullptr) {
        current = list;
        return;
    } else {
    while (copy->next != nullptr) {
        copy = copy->next;
    }
}
    copy->next = list;
}

//insert function that inserts from front
void insert(int x, node* &current) {
    node* nee = new node;

    nee->data = x;
    nee->next = current;
    current = nee;
}
// for loop that prints through everything
void print(node* temp) {
    for (node* current = temp; current; current=current->next) {
        cout << current->data << endl;
    }
}
int main () {

   node* head = new node;
    head->data = 1;
    head->next = nullptr;


add(2,head);
add(3,head);

insert(4,head);
print(head);


}
